{
  "name": "ha-custom-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Warm, accessible Home Assistant room cards built with Lit.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.10",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
